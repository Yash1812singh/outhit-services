# Copy to .env and fill in. Shared by all services.

# Shared secret services use to trust each other (only the gateway is public).
INTERNAL_TOKEN=change-me-long-random-string
# Signs login tokens. Generate: python -c 'import secrets;print(secrets.token_urlsafe(48))'
GATEWAY_JWT_SECRET=change-me
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:3050

# AI chat (advisor) and news reading (intelligence). Groq is used first, Claude as fallback.
ADVISOR_GROQ_API_KEY=
INTELLIGENCE_GROQ_API_KEY=
ADVISOR_ANTHROPIC_API_KEY=

# Service URLs (defaults are localhost ports; docker-compose sets service names).
# GATEWAY_MARKET_DATA_URL=http://127.0.0.1:8201
# GATEWAY_INTELLIGENCE_URL=http://127.0.0.1:8202
# GATEWAY_RESEARCH_URL=http://127.0.0.1:8203
# GATEWAY_ADVISOR_URL=http://127.0.0.1:8204

# SEC EDGAR asks automated clients to identify themselves (13F investor portfolios).
RESEARCH_SEC_USER_AGENT=Outhit research contact@example.com

# Real trading through your own Upstox account (broker service).
# Encrypts stored API secrets/tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_ENCRYPTION_KEY=
# Must equal the Redirect URL in your Upstox app settings.
BROKER_REDIRECT_URI=http://localhost:3050/trade/broker/callback
